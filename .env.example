# WatchLitz Environment Configuration
# ================================
# Copy this file to .env and fill in your API key:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# The .env file is already listed in .gitignore.

# OMDb API Key
# Get yours FREE at: https://www.omdbapi.com/apikey.aspx
# - Select "FREE!" tier
# - Enter your email address
# - Check your email and click the activation link
# - Free tier allows 1,000 requests per day
#
# Both OMDB_API_KEY and OMDb_API_KEY are supported.
OMDB_API_KEY=your_omdb_api_key_here
